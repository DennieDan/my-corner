{
  "name": "@dennie/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint bin lib scripts test",
    "test": "vitest run",
    "synth": "cdk synth",
    "synth:development": "cdk synth -c environment=development",
    "synth:staging": "cdk synth -c environment=staging",
    "synth:production": "cdk synth -c environment=production",
    "deploy": "cdk deploy --all",
    "deploy:development": "cdk deploy --all -c environment=development",
    "deploy:staging": "cdk deploy --all -c environment=staging",
    "deploy:production": "cdk deploy --all -c environment=production",
    "knowledge:validate": "node --import tsx scripts/validate-knowledge.ts",
    "knowledge:validate:approved": "node --import tsx scripts/validate-knowledge.ts --require-approved",
    "knowledge:upload": "node --env-file .env.local --import tsx scripts/upload-knowledge.ts",
    "knowledge:sync": "node --env-file .env.local --import tsx scripts/sync-knowledge.ts",
    "knowledge:ingest": "node --env-file .env.local --import tsx scripts/ingest-knowledge.ts",
    "knowledge:retrieve": "node --env-file .env.local --import tsx scripts/retrieve-knowledge.ts",
    "agent:smoke": "node --import tsx scripts/smoke-agent.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent": "^3.922.0",
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1106.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "aws-cdk-lib": "^2.221.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "aws-cdk": "^2.1031.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
